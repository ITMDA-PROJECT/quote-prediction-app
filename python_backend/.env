#=============================
#==Shared Environment Config==
#=============================

#Shared secret key for JWT across UserService and QuotationService
SECRET_KEY=supersecretjwtkey

#Database (each service can use the same DB or separate if needed)
#DATABASE_URL=sqlite:///./quotation_service.db
DATABASE_URL=#Add your database URL here

#ML Service URL (for predictions)
ML_SERVICE_URL=http://localhost:8001/predict

#Optional ---- SMTP (for UserService email verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=  #app
SMTP_PASS=  #apppassword
